    "send.retry.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message may have been delivered: the server could have accepted it, but the response was lost. Sending again may create a duplicate."

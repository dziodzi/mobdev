<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:gravity="center" android:orientation="vertical"
    android:padding="24dp">
    <ImageView android:layout_width="64dp" android:layout_height="64dp" android:padding="16dp"
        android:src="@drawable/ic_chat" android:background="@drawable/bg_avatar"
        app:tint="@color/avatar_ink" android:importantForAccessibility="no"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:gravity="center" android:text="@string/choose_chat"
        android:textColor="@color/muted" android:textSize="18sp"/>
</LinearLayout>

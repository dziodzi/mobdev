<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/message_card" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/bg_message_other" android:padding="12dp">
        <TextView android:id="@+id/message_author" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/primary"
            android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/message_text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/ink" android:textSize="16sp" android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"/>
        <ImageView android:id="@+id/message_image" android:layout_width="match_parent"
            android:layout_height="160dp" android:layout_marginTop="8dp"
            android:contentDescription="@string/image_message" android:scaleType="centerInside"
            android:background="@color/canvas" android:visibility="gone"/>
        <TextView android:id="@+id/message_time" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="end"
            android:layout_marginTop="6dp" android:textSize="11sp" android:textColor="@color/muted"/>
    </LinearLayout>
</LinearLayout>

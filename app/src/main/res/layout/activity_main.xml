<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8CFF4"
    android:fillViewport="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_display"
            android:gravity="end|center_vertical"
            android:padding="16dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:maxLines="1"
            android:ellipsize="start" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="4"
            android:rowCount="5"
            >

            <Button
                android:id="@+id/btnClearOne"
                style="@style/CalcButtonOperation"
                android:text="⌫"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAC"
                style="@style/CalcButtonOperation"
                android:text="C" />

            <Button
                android:id="@+id/btnFloat"
                style="@style/CalcButtonOperation"
                android:text="," />

            <Button
                android:id="@+id/btnDelenie"
                style="@style/CalcButtonOperation"
                android:text="/" />

            <Button
                android:id="@+id/btn7"
                style="@style/CalcButtonNumber"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                style="@style/CalcButtonNumber"
                android:text="8" />

            <Button
                android:id="@+id/btn9"
                style="@style/CalcButtonNumber"
                android:text="9" />

            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButtonOperation"
                android:text="+" />

            <Button
                android:id="@+id/btn4"
                style="@style/CalcButtonNumber"
                android:text="4" />

            <Button
                android:id="@+id/btn5"
                style="@style/CalcButtonNumber"
                android:text="5" />

            <Button
                android:id="@+id/btn6"
                style="@style/CalcButtonNumber"
                android:text="6" />

            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButtonOperation"
                android:text="-" />

            <Button
                android:id="@+id/btn1"
                style="@style/CalcButtonNumber"
                android:text="1" />

            <Button
                android:id="@+id/btn2"
                style="@style/CalcButtonNumber"
                android:text="2" />

            <Button
                android:id="@+id/btn3"
                style="@style/CalcButtonNumber"
                android:text="3" />

            <Button
                android:id="@+id/btnUmnozhenie"
                style="@style/CalcButtonOperation"
                android:text="*" />

            <Button
                android:id="@+id/btnPlusMinus"
                style="@style/CalcButtonOperation"
                android:text="±" />

            <Button
                android:id="@+id/btn0"
                style="@style/CalcButtonNumber"
                android:text="0" />

            <Button
                android:id="@+id/btnSqrt"
                style="@style/CalcButtonOperation"
                android:text="√" />

            <Button
                android:id="@+id/btnRes"
                style="@style/CalcButtonOperation"
                android:text="=" />

            </GridLayout>
    </LinearLayout>
</ScrollView>